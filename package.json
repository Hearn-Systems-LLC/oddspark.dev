{
  "name": "oddspark",
  "version": "1.0.0",
  "private": true,
  "description": "A button that hands you one content idea, deterministically derived from drand quicknet + NOAA GOES X-ray flux.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.offline.toml",
    "test": "node test.mjs",
    "test:baseline": "node scripts/runtime-baseline.test.mjs",
    "types": "wrangler types",
    "check:types": "node scripts/check-types.mjs",
    "check:config": "node scripts/check-config.mjs",
    "baseline:freeze": "node scripts/runtime-baseline.mjs freeze",
    "baseline:verify": "node scripts/runtime-baseline.mjs verify",
    "check": "npm run test && npm run test:baseline && npm run check:types && npm run check:config && npm run baseline:verify",
    "deploy": "wrangler deploy",
    "spike:judge:self-test": "node spikes/judge-fidelity/test.mjs",
    "spike:judge:verify": "node spikes/judge-fidelity/run.mjs verify",
    "spike:judge:verify:v2": "node spikes/judge-fidelity/verify-v2.mjs",
    "spike:judge:verify-launcher": "node spikes/judge-fidelity/verify-launcher.mjs",
    "spike:judge:dev": "node spikes/judge-fidelity/start-adapter.mjs",
    "spike:judge:live": "node spikes/judge-fidelity/run.mjs live"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
