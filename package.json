{
  "name": "oddspark",
  "version": "1.0.0",
  "private": true,
  "description": "A button that hands you one content idea, deterministically derived from drand quicknet + NOAA GOES X-ray flux.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.offline.toml",
    "test": "node test.mjs",
    "test:baseline": "node scripts/runtime-baseline.test.mjs",
    "types": "wrangler types",
    "check:types": "node scripts/check-types.mjs",
    "check:config": "node scripts/check-config.mjs",
    "baseline:freeze": "node scripts/runtime-baseline.mjs freeze",
    "baseline:verify": "node scripts/runtime-baseline.mjs verify",
    "semantic:voice:test": "node --test scripts/semantic-corpus.test.mjs",
    "semantic:voice:verify": "node scripts/semantic-corpus.mjs",
    "local-priors:test": "node --test scripts/local-priors.test.mjs",
    "local-priors:verify": "node scripts/local-priors.mjs",
    "local-evidence:test": "node --test scripts/local-evidence.test.mjs",
    "generation:test": "node --test scripts/generation.test.mjs",
    "brief-contracts:test": "node --test scripts/brief-contracts.test.mjs",
    "house-briefs:test": "node --test scripts/house-briefs.test.mjs",
    "house-briefs:verify": "node scripts/house-briefs.mjs",
    "composite-gate:test": "node --test scripts/composite-gate.test.mjs",
    "strike-orchestrator:test": "node --test scripts/strike-orchestrator.test.mjs",
    "check": "npm run test && npm run test:baseline && npm run spike:judge:self-test && npm run spike:generation:self-test && npm run semantic:voice:test && npm run local-priors:test && npm run local-evidence:test && npm run generation:test && npm run brief-contracts:test && npm run house-briefs:test && npm run composite-gate:test && npm run strike-orchestrator:test && npm run check:types && npm run check:config && npm run baseline:verify",
    "deploy": "wrangler deploy",
    "spike:judge:self-test": "node spikes/judge-fidelity/test.mjs",
    "spike:judge:verify": "node spikes/judge-fidelity/verify-v2.mjs",
    "spike:judge:verify:v1": "node spikes/judge-fidelity/run.mjs verify",
    "spike:judge:verify:v2": "node spikes/judge-fidelity/verify-v2.mjs",
    "spike:judge:verify-launcher": "node spikes/judge-fidelity/verify-launcher.mjs",
    "spike:judge:dev": "node spikes/judge-fidelity/start-adapter.mjs",
    "spike:judge:plan": "node spikes/judge-fidelity/run.mjs plan",
    "spike:judge:qualification:verify": "node spikes/judge-fidelity/qualification.mjs verify",
    "spike:judge:live": "node spikes/judge-fidelity/run.mjs live",
    "spike:generation:self-test": "node --test spikes/generation-qualification/test.mjs",
    "spike:generation:verify": "node spikes/generation-qualification/verify-v2.mjs",
    "spike:generation:dev": "node spikes/generation-qualification/start-adapter.mjs",
    "spike:generation:plan": "node spikes/generation-qualification/run.mjs plan",
    "spike:generation:live": "node spikes/generation-qualification/run.mjs live"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
