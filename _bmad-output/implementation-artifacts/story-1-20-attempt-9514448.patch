diff --git a/scripts/release-decision.mjs b/scripts/release-decision.mjs
new file mode 100644
index 0000000..748264e
--- /dev/null
+++ b/scripts/release-decision.mjs
@@ -0,0 +1,34 @@
+#!/usr/bin/env node
+import { readFile } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+import { renderReleaseDecision } from "../src/pipeline/release-decision.mjs";
+
+export async function renderInput(text) {
+  let value;
+  try { value = JSON.parse(text); } catch { throw new TypeError("activation_snapshot_malformed"); }
+  return `${JSON.stringify(renderReleaseDecision(value))}\n`;
+}
+
+async function main(argv = process.argv.slice(2)) {
+  if (argv.length > 1) throw new TypeError("usage: release-decision [snapshot.json]");
+  let text;
+  if (argv.length === 1) text = await readFile(argv[0], "utf8");
+  else {
+    text = "";
+    process.stdin.setEncoding("utf8");
+    for await (const chunk of process.stdin) text += chunk;
+  }
+  const output = await renderInput(text);
+  process.stdout.write(output);
+  return JSON.parse(output).ready ? 0 : 2;
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
+  main().then((code) => { process.exitCode = code; }).catch((error) => {
+    const message = error instanceof Error && /^activation_snapshot_[a-z_]+$/.test(error.message)
+      ? error.message : "activation_snapshot_malformed";
+    process.stderr.write(`${message}\n`);
+    process.exitCode = 1;
+  });
+}
