diff --git a/src/pipeline/release-decision.mjs b/src/pipeline/release-decision.mjs
new file mode 100644
index 0000000..4a95ddc
--- /dev/null
+++ b/src/pipeline/release-decision.mjs
@@ -0,0 +1,98 @@
+import { deepFreeze } from "./contracts.mjs";
+import { deriveActivationRef, validateProductionActivationManifest } from "./activation.mjs";
+
+export const ACTIVATION_SNAPSHOT_VERSION = 1;
+export const SNAPSHOT_REASON_CODES = deepFreeze({
+  MISSING: "activation_snapshot_missing",
+  MALFORMED: "activation_snapshot_malformed",
+  NOT_CLOSED: "activation_snapshot_not_closed",
+  MANIFEST: "activation_snapshot_manifest_invalid",
+  EVIDENCE: "activation_snapshot_evidence_invalid",
+  STALE: "activation_snapshot_stale",
+  BLOCKED: "activation_snapshot_blocked",
+  UNAPPROVED: "activation_snapshot_unapproved",
+});
+
+const SHA256 = /^[a-f0-9]{64}$/;
+const SNAPSHOT_KEYS = ["version", "manifest", "facts"];
+const FACT_KEYS = ["gate_id", "expected_ref", "current_ref", "verified", "approved"];
+const closed = (value, keys) => {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) return false;
+  const ownKeys = Reflect.ownKeys(value);
+  return ownKeys.length === keys.length && ownKeys.every((key) => typeof key === "string")
+    && keys.every((key) => Object.hasOwn(value, key));
+};
+
+const invalid = (reason) => deepFreeze({ valid: false, ready: false, reason, decision: null, manifest: null });
+
+function inertTree(value, seen = new Set()) {
+  if (value === null || typeof value !== "object") return true;
+  if (seen.has(value)) return false;
+  seen.add(value);
+  const prototype = Object.getPrototypeOf(value);
+  if (prototype !== Object.prototype && prototype !== null && prototype !== Array.prototype) return false;
+  const descriptors = Object.getOwnPropertyDescriptors(value);
+  for (const key of Reflect.ownKeys(descriptors)) {
+    const descriptor = descriptors[key];
+    if (descriptor.get || descriptor.set || !("value" in descriptor) || !inertTree(descriptor.value, seen)) return false;
+  }
+  seen.delete(value);
+  return true;
+}
+
+export function applicableActivationGates(manifest) {
+  const gates = [
+    { gate_id: "deployed_source", expected_ref: manifest.deployed_source_identity, ref_kind: "identity" },
+    { gate_id: "generation", expected_ref: manifest.generation_ref, ref_kind: "hash" },
+    { gate_id: "judge", expected_ref: manifest.judge_ref, ref_kind: "hash" },
+    { gate_id: "house_catalog", expected_ref: manifest.house_catalog_ref, ref_kind: "hash" },
+  ];
+  if (manifest.local.enabled) gates.push({ gate_id: "local_full_request", expected_ref: manifest.local.full_request_ref, ref_kind: "hash" });
+  if (manifest.domain.enabled) {
+    gates.push({ gate_id: "domain_evidence", expected_ref: manifest.domain.evidence_ref, ref_kind: "hash" });
+    gates.push({ gate_id: "domain_full_request", expected_ref: manifest.domain.full_request_ref, ref_kind: "hash" });
+  }
+  if (manifest.receiver_ref !== null) gates.push({ gate_id: "receiver", expected_ref: manifest.receiver_ref, ref_kind: "hash" });
+  if (manifest.receipt_claim_ref !== null) gates.push({ gate_id: "receipt_claim", expected_ref: manifest.receipt_claim_ref, ref_kind: "hash" });
+  return gates;
+}
+
+export function evaluateActivationSnapshot(value) {
+  if (value === undefined || value === null) return invalid(SNAPSHOT_REASON_CODES.MISSING);
+  let snapshot = value;
+  if (typeof snapshot === "string") {
+    try { snapshot = JSON.parse(snapshot); } catch { return invalid(SNAPSHOT_REASON_CODES.MALFORMED); }
+  }
+  if (!inertTree(snapshot) || !closed(snapshot, SNAPSHOT_KEYS) || snapshot.version !== ACTIVATION_SNAPSHOT_VERSION || !Array.isArray(snapshot.facts)) {
+    return invalid(SNAPSHOT_REASON_CODES.NOT_CLOSED);
+  }
+  const manifestValidation = validateProductionActivationManifest(snapshot.manifest);
+  if (!manifestValidation.valid) return invalid(SNAPSHOT_REASON_CODES.MANIFEST);
+  const gates = applicableActivationGates(snapshot.manifest);
+  if (snapshot.facts.length !== gates.length) return invalid(SNAPSHOT_REASON_CODES.EVIDENCE);
+  const rows = [];
+  for (let index = 0; index < gates.length; index++) {
+    const fact = snapshot.facts[index];
+    const { gate_id: gateId, expected_ref: expectedRef, ref_kind: refKind } = gates[index];
+    if (!closed(fact, FACT_KEYS) || fact.gate_id !== gateId || fact.expected_ref !== expectedRef
+        || typeof fact.current_ref !== "string" || (refKind === "hash" ? !SHA256.test(fact.current_ref) : fact.current_ref.trim() === "")
+        || typeof fact.verified !== "boolean" || typeof fact.approved !== "boolean") {
+      return invalid(SNAPSHOT_REASON_CODES.EVIDENCE);
+    }
+    const status = fact.current_ref !== expectedRef ? "stale" : !fact.verified ? "blocked" : !fact.approved ? "unapproved" : "pass";
+    rows.push({ gate_id: gateId, status });
+  }
+  const activationRef = deriveActivationRef(snapshot.manifest);
+  const ready = rows.every(({ status }) => status === "pass");
+  const firstFailure = rows.find(({ status }) => status !== "pass")?.status;
+  const reason = firstFailure ? SNAPSHOT_REASON_CODES[firstFailure.toUpperCase()] : null;
+  const manifest = structuredClone(snapshot.manifest);
+  const decision = { version: 1, activation_ref: activationRef, ready, gates: rows };
+  return deepFreeze({ valid: true, ready, reason, decision, manifest });
+}
+
+export function renderReleaseDecision(value) {
+  const result = evaluateActivationSnapshot(value);
+  if (!result.valid) throw new TypeError(result.reason);
+  return result.decision;
+}
