new file mode 100644
index 0000000..f9a43ee
--- /dev/null
+++ b/scripts/release-decision.test.mjs
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+import { deriveActivationRef } from "../src/pipeline/activation.mjs";
+import { SNAPSHOT_REASON_CODES, applicableActivationGates, evaluateActivationSnapshot, renderReleaseDecision } from "../src/pipeline/release-decision.mjs";
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const manifest = () => ({ version: 2, deployed_source_identity: "deploy-123", generation_ref: "a".repeat(64), judge_ref: "b".repeat(64), local: { enabled: true, full_request_ref: "c".repeat(64) }, domain: { enabled: false, evidence_ref: null, full_request_ref: null }, house_catalog_ref: "d".repeat(64), receiver_ref: null, receipt_claim_ref: null, outcome: "active" });
+const snapshot = (m = manifest()) => ({ version: 1, manifest: m, facts: applicableActivationGates(m).map(({ gate_id, expected_ref }) => ({ gate_id, expected_ref, current_ref: expected_ref, verified: true, approved: true })) });
+
+test("ready snapshot derives the sole manifest ref and canonical frozen view", () => {
+  const input = snapshot(); const before = structuredClone(input); const decision = renderReleaseDecision(input);
+  assert.deepEqual(input, before); assert.equal(decision.activation_ref, deriveActivationRef(input.manifest));
+  assert.deepEqual(decision.gates.map((row) => row.gate_id), ["deployed_source", "generation", "judge", "house_catalog", "local_full_request"]);
+  assert.ok(decision.ready && Object.isFrozen(decision) && Object.isFrozen(decision.gates));
+});
+
+test("status precedence is stale, blocked, unapproved, then pass", () => {
+  for (const [status, mutate] of [["stale", (f) => { f.current_ref = "f".repeat(64); }], ["blocked", (f) => { f.verified = false; }], ["unapproved", (f) => { f.approved = false; }]]) {
+    const input = snapshot(); mutate(input.facts[1]); const result = evaluateActivationSnapshot(input);
+    assert.equal(result.ready, false); assert.equal(result.decision.gates[1].status, status); assert.equal(result.reason, SNAPSHOT_REASON_CODES[status.toUpperCase()]);
+  }
+});
+
+test("closed boundary rejects omissions, extras, duplicates, parallel refs, and inconsistent identities", () => {
+  const mutations = [(s) => { s.extra = true; }, (s) => { s.activation_ref = "e".repeat(64); }, (s) => { s.facts.pop(); }, (s) => { s.facts.push(structuredClone(s.facts[0])); }, (s) => { s.facts[1].gate_id = s.facts[0].gate_id; }, (s) => { s.manifest.semantic_ref = "e".repeat(64); }, (s) => { s.facts[1].expected_ref = "e".repeat(64); }];
+  for (const mutate of mutations) { const input = snapshot(); mutate(input); assert.equal(evaluateActivationSnapshot(input).valid, false); }
+});
+
+test("prototype, getter, and cycle inputs reject without invoking code", () => {
+  let invoked = false; const getter = snapshot(); Object.defineProperty(getter, "extra", { enumerable: true, get() { invoked = true; return 1; } });
+  assert.equal(evaluateActivationSnapshot(getter).valid, false); assert.equal(invoked, false);
+  const cyclic = snapshot(); cyclic.loop = cyclic; assert.equal(evaluateActivationSnapshot(cyclic).valid, false);
+  const polluted = snapshot(); Object.setPrototypeOf(polluted.facts[0], { surprise: true }); assert.equal(evaluateActivationSnapshot(polluted).valid, false);
+  const hidden = snapshot(); Object.defineProperty(hidden, "hidden", { value: true }); assert.equal(evaluateActivationSnapshot(hidden).valid, false);
+  const symbol = snapshot(); symbol[Symbol("hidden")] = true; assert.equal(evaluateActivationSnapshot(symbol).valid, false);
+});
+
+test("domain and nullable publication gates are derived exactly from manifest applicability", () => {
+  const domain = manifest(); domain.local = { enabled: false, full_request_ref: null }; domain.domain = { enabled: true, evidence_ref: "e".repeat(64), full_request_ref: "f".repeat(64) }; domain.receiver_ref = "1".repeat(64); domain.receipt_claim_ref = "2".repeat(64);
+  assert.deepEqual(renderReleaseDecision(snapshot(domain)).gates.map(({ gate_id }) => gate_id), ["deployed_source", "generation", "judge", "house_catalog", "domain_evidence", "domain_full_request", "receiver", "receipt_claim"]);
+  const local = renderReleaseDecision(snapshot()); assert.equal(local.ready, true); assert.equal(local.gates.some(({ gate_id }) => gate_id === "receiver" || gate_id === "receipt_claim"), false);
+});
+
+test("CLI is import-safe, deterministic, read-only, and exits nonzero when not ready", () => {
+  const dir = mkdtempSync(path.join(tmpdir(), "oddspark-decision-")); const file = path.join(dir, "snapshot.json"); const input = snapshot(); writeFileSync(file, JSON.stringify(input));
+  const run = () => spawnSync(process.execPath, ["scripts/release-decision.mjs", file], { cwd: ROOT, encoding: "utf8" });
+  const first = run(); const second = run(); assert.equal(first.status, 0); assert.equal(first.stdout, second.stdout); assert.equal(readFileSync(file, "utf8"), JSON.stringify(input));
+  input.facts[1].approved = false; const blocked = spawnSync(process.execPath, ["scripts/release-decision.mjs"], { cwd: ROOT, input: JSON.stringify(input), encoding: "utf8" }); assert.equal(blocked.status, 2); assert.equal(JSON.parse(blocked.stdout).ready, false);
+  const imported = spawnSync(process.execPath, ["--input-type=module", "-e", "import './scripts/release-decision.mjs'"], { cwd: ROOT, encoding: "utf8" }); assert.equal(imported.status, 0); assert.equal(imported.stdout, ""); assert.equal(imported.stderr, "");
+  const missing = spawnSync(process.execPath, ["scripts/release-decision.mjs", path.join(dir, "secret-name.json")], { cwd: ROOT, encoding: "utf8" }); assert.equal(missing.status, 1); assert.equal(missing.stderr, "activation_snapshot_malformed\n"); assert.equal(missing.stderr.includes("secret-name"), false);
+});
